rules_version = '2';

// El navegador SOLO lee. Todas las escrituras van por la API de Next, que usa
// el Admin SDK y se salta estas reglas: así la validación (no reclamar más
// unidades de las que hay, un único pagador, los topes de tamaño) vive en un
// sitio donde nadie puede saltársela desde la consola del móvil.
service cloud.firestore {
  match /databases/{database}/documents {

    match /tickets/{code} {
      // Quien tiene el código de la comanda puede verla; es lo mismo que
      // asume el QR impreso en el ticket. No hay datos personales más allá
      // del nombre de pila que cada uno escribe.
      allow get: if true;

      // Listar la colección expondría todas las comandas del sistema.
      allow list: if false;

      allow create, update, delete: if false;
    }

    // Las cuentas. Ni siquiera la propia: todo pasa por /api/cuenta con el
    // token en la cabecera, que es donde se valida lo que se guarda. Se deja
    // explícito para que nadie abra esto «sólo para leer la mía» y se lleve
    // por delante el correo de todo el mundo.
    match /users/{uid} {
      allow read, write: if false;
    }

    // Amistades, asientos reservados, códigos de amigo y el registro de los
    // correos mandados. Todo por la API con el token; nada desde el navegador.
    match /users/{uid}/amigos/{otro} {
      allow read, write: if false;
    }
    match /invitaciones/{id} {
      allow read, write: if false;
    }
    match /codigos/{codigo} {
      allow read, write: if false;
    }
    match /usuarios/{usuario} {
      allow read, write: if false;
    }
    match /correos/{id} {
      allow read, write: if false;
    }

    // Contadores de los topes de uso. La regla general de abajo ya los cierra;
    // se deja explícito porque leerlos diría a quien ataca cuánto cupo queda, y
    // escribirlos sería quitarse el tope de encima.
    match /limits/{key} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
