# Necesaria para leer tickets con la cámara (visión de Claude).
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- Firestore
# Crea el proyecto con `firebase projects:create` y la base con
# `firebase firestore:databases:create "(default)" --location eur3`.
FIREBASE_PROJECT_ID=

# Credenciales del Admin SDK (sólo servidor). En local basta con `firebase login`;
# al desplegar, pega el JSON de una cuenta de servicio en una sola línea.
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/credenciales.json
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Configuración pública del SDK del navegador (`firebase apps:sdkconfig WEB`).
# Sólo permite leer en directo; escribir está prohibido en firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------ Meta Ads
# El píxel del Administrador de Eventos (Administrador de eventos > Orígenes
# de datos > tu píxel > el número de arriba). Vacío = no se carga nada de
# Meta y los eventos se quedan en nada.
NEXT_PUBLIC_META_PIXEL_ID=

# ------------------------------------------------------------------ Métricas
# La llave de /metricas. Sin ella la ruta devuelve 404, así que no hace falta
# ningún sistema de usuarios. Invéntate una larga:
#   openssl rand -hex 16
# Al desplegar va en Secret Manager, nunca en apphosting.yaml.
METRICAS_TOKEN=
