# --------------------------------------------------------------------- OCR
# Qué modelo lee los tickets. `gemini` (por defecto) o `anthropic`.
# Es la única variable que crece con los usuarios, así que se cambia por
# configuración para poder probar otro modelo y volverse atrás sin tocar código.
OCR_MODELO=gemini

# Gemini 3.7 Flash. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude Opus 5, la alternativa (OCR_MODELO=anthropic).
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- Firestore
# Crea el proyecto con `firebase projects:create` y la base con
# `firebase firestore:databases:create "(default)" --location eur3`.
FIREBASE_PROJECT_ID=

# Credenciales del Admin SDK (sólo servidor). En local basta con `firebase login`;
# al desplegar, pega el JSON de una cuenta de servicio en una sola línea.
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/credenciales.json
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Configuración pública del SDK del navegador (`firebase apps:sdkconfig WEB`).
# Sólo permite leer en directo; escribir está prohibido en firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------ Meta Ads
# El píxel del Administrador de Eventos (Administrador de eventos > Orígenes
# de datos > tu píxel > el número de arriba). Vacío = no se carga nada de
# Meta y los eventos se quedan en nada.
NEXT_PUBLIC_META_PIXEL_ID=

# ------------------------------------------------------------------ Métricas
# La llave de /metricas. Sin ella la ruta devuelve 404, así que no hace falta
# ningún sistema de usuarios. Invéntate una larga:
#   openssl rand -hex 16
# Al desplegar va en Secret Manager, nunca en apphosting.yaml.
METRICAS_TOKEN=

# --- El correo de la app (lib/correo.ts) -------------------------------------
# Sale de hola@divifriends.es por el SMTP de Hostinger. Sin SMTP_CLAVE no se
# manda nada y la app funciona igual. La contraseña del buzón la pones tú aquí
# (en .env.local), nunca en el repo.
SMTP_HOST=smtp.hostinger.com
SMTP_PUERTO=465
SMTP_USUARIO=hola@divifriends.es
SMTP_CLAVE=
# Firma los enlaces de baja de los correos. Cualquier cadena larga al azar.
CORREO_SECRETO=
# Freno global de correos al día: al 60 % del plan del buzón.
CORREO_TOPE_DIA=60

# De dónde salen los enlaces de los correos. En producción va en apphosting.yaml;
# sin él, el servidor sólo se fía de divifriends.es y de localhost.
SITIO_URL=http://localhost:3000
